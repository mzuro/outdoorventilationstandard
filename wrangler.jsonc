{
  "name": "outdoorventilationstandard",
  "compatibility_date": "2026-02-09",
  "main": "src/worker.js",
  // Disable the outdoorventilationstandard.markzuro.workers.dev mirror: static
  // assets are served before the Worker runs, so the noindex header in
  // src/worker.js never reaches HTML there and the mirror was indexable
  // duplicate content. Branch preview URLs (preview_urls) are unaffected.
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serve Hugo's public/404.html with a 404 status instead of an empty body.
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    {
      "binding": "QUESTION_CLICKS",
      "id": "ff274b77a21a4990870979944d2c92d6"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
